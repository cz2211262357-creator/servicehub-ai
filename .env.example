SERVICEHUB_ENVIRONMENT=development
SERVICEHUB_DATABASE_URL=mysql+asyncmy://servicehub:dev-password@127.0.0.1:3306/servicehub
SERVICEHUB_REDIS_URL=redis://127.0.0.1:6379/0
SERVICEHUB_MODEL_MODE=online
SERVICEHUB_COOKIE_SECURE=false
SERVICEHUB_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
SERVICEHUB_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SERVICEHUB_MODEL_NAME=qwen-plus
SERVICEHUB_MODEL_API_KEY=
SERVICEHUB_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SERVICEHUB_EMBEDDING_MODEL=text-embedding-v4
SERVICEHUB_EMBEDDING_API_KEY=
SERVICEHUB_EMBEDDING_DIMENSIONS=1024

# Retrieval migration and reproducible sampling
SERVICEHUB_RETRIEVAL_BACKEND=redis_hybrid
SERVICEHUB_MODEL_TEMPERATURE=0
# Optional estimates: use your actual model/region/tier. Blank means unknown, not free.
# SERVICEHUB_MODEL_INPUT_PRICE_PER_MILLION=
# SERVICEHUB_MODEL_OUTPUT_PRICE_PER_MILLION=
# SERVICEHUB_MODEL_PRICE_VERSION=
